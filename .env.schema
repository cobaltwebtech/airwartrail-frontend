# This env file uses @env-spec - see https://varlock.dev/env-spec for more info
#
# Air War Trail frontend (Astro SSR on Cloudflare Workers)
#
# Layout:
#   .env.schema   committed; declares every variable, its type, and non-secret defaults
#   .env.local    gitignored; per-developer values. Secrets are stored as
#                 varlock("local:...") ciphertext (Secure Enclave + Touch ID on macOS)
#   .env.production  gitignored; production overrides, applied when APP_ENV=production
#
# To add or rotate a secret locally, run `pnpm env:encrypt` (encrypts @sensitive
# plaintext values in .env.local and .env.production in place). Never commit plaintext secrets.
#
# @defaultRequired=infer @defaultSensitive=false
# @currentEnv=$APP_ENV
# @generateTypes(lang=ts, path=env.d.ts)
# ----------

# Selects which .env.<env> overrides are loaded. Production builds/deploys set this.
# @type=enum(development, production)
APP_ENV=development

# ---------- Better Auth ----------

# Public origin of the site
# @required @type=url
BETTER_AUTH_URL=if(eq($APP_ENV, production), "https://www.airwartrail.com", "http://localhost:4321")

# @required @sensitive @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Better Auth Infra (dashboard) API key. Only needed in production; dev uses a
# placeholder because the plugin requires some value. Set the real key in
# .env.production (encrypted) or as a Cloudflare build secret.
# @required @sensitive=forEnv(production) @type=string
BETTER_AUTH_API_KEY=1234

# ---------- Email (Resend) ----------

# @required @sensitive @type=string(startsWith="re_")
RESEND_API_KEY=

# ---------- Turnstile ----------

# Safe for the browser
# @required @public @type=string
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAABigvVfdn9-L_sZY

# @required @sensitive @type=string
TURNSTILE_SECRET_KEY=

# ---------- Stripe ----------

# Publishable key, safe for the browser
# @required @public @type=string(startsWith="pk_")
PUBLIC_STRIPE_KEY=

# @required @sensitive @type=string(matches=regex("^(sk|rk)_"))
STRIPE_SECRET_KEY=

# @required @sensitive @type=string(startsWith="whsec_")
STRIPE_WEBHOOK_SECRET=

# @required @type=string(startsWith="price_")
STRIPE_PRICE_ID=

# ---------- Mux / video libraries ----------

# @required @type=string
AWT_BASIC_LIBRARY_ID=pnr6CRTe

# @required @type=string
AWT_PREMIUM_LIBRARY_ID=WM2OkZia

# ---------- CMS (service binding AWT_CMS) ----------

# API key sent as x-api-key to the CMS Worker
# @required @sensitive @type=string
AWT_CMS_API_KEY=
