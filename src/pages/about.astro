---

import { Image } from "astro:assets";
import { getLiveEntry } from "astro:content";
import { env } from "cloudflare:workers";
import OldSegundoLogo from "@/assets/static/old-segundo-logo.png";
import { Button } from "@/components/ui/button";
import { VideoEmbed } from "@/components/video/VideoEmbed";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { signTiptapImages } from "@/lib/sign-blog-images";
import { splitAtHorizontalRule, tiptapToHtml } from "@/lib/tiptap";

// Fetch the About page content managed in the CMS
// This calls loadEntry in the siteContent loader, which fetches content via siteContent.get
const result = await getLiveEntry("siteContent", { key: "about" });

if (result.error) {
  console.error("Failed to load About page content:", result.error.message);
}

const content = result.entry?.data.content ?? null;

// Sign any images in the content
const signedImageMap = await signTiptapImages(content, env, Astro.request);

// Content above the first horizontal rule sits beside the video; the rest runs below it
const { before, after } = splitAtHorizontalRule(content);
const introHtml = tiptapToHtml(before, { signedImageMap });
const bodyHtml = tiptapToHtml(after, { signedImageMap });
---

<BaseLayout
  title={`About Air War Trail | Air War Trail`}
  structuredData={{
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": "https://www.airwartrail.com/about/",
    url: "https://www.airwartrail.com/about/",
    name: "About | Air War Trail",
    description:
      "In 2002 Military Historian and Producer/Director Vernon L. Williams established the East Anglia Air War Project with a mission to document the American air war against the German empire in the ETO.",
    isPartOf: {
      "@type": "WebSite",
      url: "https://www.airwartrail.com/",
      name: "Air War Trail",
      description:
        "The documentary films, interviews, and images bring the voices alive from those who experienced World War II in an up close and personal way. Air War Trail's mission is to bring you their stories, when freedom stood in the balance and a generation of the free made a difference in the world.",
    },
    inLanguage: "en-US",
  }}
>
  <div class="container mx-auto px-4 py-8">
    <h1 class="mb-8 text-center text-3xl font-bold">About the Air War Trail</h1>
    <div class="mx-auto mb-10 grid gap-8 text-justify md:grid-cols-2">
      <div class="prose dark:prose-invert max-w-none">
        <Fragment set:html={introHtml} />
      </div>
      <div
        class="from-primary via-card/40 to-primary aspect-video rounded-lg bg-linear-to-tr p-4"
      >
      <VideoEmbed
        client:load
        videoId="e1gbNkw66MJ3p08vMhbTZouu"
        libraryId="pnr6CRTe"
        thumbnailTime={5}
      />
      </div>
    </div>
    {bodyHtml && (
      <div class="prose dark:prose-invert mb-10 max-w-none">
        <Fragment set:html={bodyHtml} />
      </div>
    )}
    <div class="flex flex-col items-center space-y-4">
      <a href="https://www.oldsegundo.com/" target="_blank" rel="noopener">
        <Image
          src={OldSegundoLogo}
          loading="lazy"
          width={400}
          height={400}
          alt="Old Segundo Productions Logo"
        />
        <span class="sr-only">Visit Old Segundo Productions</span>
      </a>
      <a href="https://www.oldsegundo.com/" target="_blank" rel="noopener">
        <Button className="text-xl font-bold" size="lg"
          >Check Out Old Segundo</Button
        >
      </a>
    </div>
  </div>
</BaseLayout>
