{
  "name": "airwartrail-frontend",
  "type": "module",
  "version": "2.2.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:cf": "astro build && pnpx wrangler dev",
    "format": "biome format --write",
    "lint": "biome lint",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 astro build",
    "deploy:cf": "astro build && pnpx wrangler deploy",
    "preview": "astro build && astro preview",
    "up:astro": "pnpx @astrojs/upgrade",
    "up:biome": "pnpm up @biomejs/biome@latest && pnpm biome migrate --write",
    "clean": "rm -rf dist node_modules pnpm-lock.yaml .astro"
  },
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "@astrojs/cloudflare": "14.2.5",
    "@astrojs/react": "6.0.4",
    "@astrojs/sitemap": "^3.7.3",
    "@better-auth/drizzle-adapter": "^1.7.2",
    "@better-auth/infra": "^0.4.3",
    "@better-auth/stripe": "^1.7.2",
    "@hookform/resolvers": "^5.9.1",
    "@lucide/astro": "^1.34.0",
    "@marsidev/react-turnstile": "^1.6.1",
    "@mux/mux-player-react": "^3.13.2",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@stripe/react-stripe-js": "^6.8.2",
    "@stripe/stripe-js": "^9.14.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.6",
    "@tanstack/react-query-devtools": "^5.102.6",
    "@tanstack/react-virtual": "^3.14.10",
    "@trpc/client": "^11.18.0",
    "@trpc/tanstack-react-query": "^11.18.0",
    "astro": "7.2.8",
    "better-auth": "1.7.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel": "9.0.0-rc03",
    "embla-carousel-autoplay": "9.0.0-rc03",
    "embla-carousel-react": "9.0.0-rc03",
    "lenis": "^1.3.26",
    "lucide-react": "^1.34.0",
