{
  "name": "airwartrail-frontend",
  "type": "module",
  "version": "2.4.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "dev:cf": "astro build && pnpm exec varlock-wrangler dev",
    "format": "biome format --write",
    "lint": "biome lint",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 astro build",
    "deploy:cf": "APP_ENV=production astro build && APP_ENV=production pnpm exec varlock-wrangler deploy",
    "preview": "astro build && astro preview",
    "env:load": "varlock load --agent",
    "env:encrypt": "varlock encrypt --file .env.local && APP_ENV=production varlock encrypt --file .env.production",
    "env:encrypt:dev": "varlock encrypt --file .env",
    "cf:types": "varlock-wrangler types",
    "up:astro": "pnpx @astrojs/upgrade",
    "up:biome": "pnpm up @biomejs/biome@latest && pnpm biome migrate --write",
    "clean": "rm -rf dist node_modules pnpm-lock.yaml .astro"
  },
  "packageManager": "pnpm@12.16.1",
  "dependencies": {
    "@astrojs/cloudflare": "14.4.2",
    "@astrojs/react": "7.1.1",
    "@astrojs/sitemap": "^3.7.4",
    "@better-auth/drizzle-adapter": "^1.7.14",
    "@better-auth/infra": "^0.4.24",
    "@better-auth/stripe": "^1.7.14",
    "@hookform/resolvers": "^6.0.2",
    "@lucide/astro": "^1.63.0",
    "@marsidev/react-turnstile": "^1.6.3",
    "@mux/mux-player-react": "^3.14.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@stripe/react-stripe-js": "^7.0.1",
    "@stripe/stripe-js": "^10.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-devtools": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.23",
    "@trpc/client": "^11.19.0",
    "@trpc/tanstack-react-query": "^11.19.0",
    "@varlock/astro-integration": "^1.4.4",
    "@varlock/cloudflare-integration": "^1.6.2",
    "astro": "7.4.2",
    "better-auth": "1.7.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "embla-carousel": "9.0.0-rc03",
    "embla-carousel-autoplay": "9.0.0-rc03",
    "embla-carousel-react": "9.0.0-rc03",
    "lenis": "^1.3.27",
    "lucide-react": "^1.63.0",
    "preline": "^5.0.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.4",
    "react-hook-form": "^7.91.0",
    "resend": "^6.35.0",
    "sonner": "^2.0.8",
    "stripe": "23.0.1",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "varlock": "^1.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@trpc/server": "^11.19.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "oxc-transform-react": "^0.156.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.156.0"
  }
}
